<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".LoginFragment"
    android:background="#1B5000">



    <ImageView
        android:padding="20dp"
        android:layout_marginTop="10dp"
        android:id="@+id/login2img"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:src="@drawable/login2rasm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="20dp"
            android:background="@drawable/shape_login_edt"
            android:hint="Login"
            android:paddingLeft="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="20dp"
            android:background="@drawable/shape_login_edt"
            android:hint="Parol"
            android:paddingLeft="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="20dp"
            android:background="@drawable/shape_login_edt"
            android:hint="Takroriy parol"
            android:paddingLeft="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </LinearLayout>

<androidx.appcompat.widget.AppCompatButton
  android:layout_marginRight="20dp"
    android:layout_marginLeft="20dp"
    android:background="@drawable/shape_btn"
    app:layout_constraintBottom_toBottomOf="parent"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="80dp"
    android:text="Ro'yxatdan o'tish"
    android:textStyle="bold"
    android:textSize="20dp"
    android:textColor="#282A27"/>

</androidx.constraintlayout.widget.ConstraintLayout>