<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".LoginFragment"
    android:background="@drawable/fon">

    <ImageView
        android:padding="20dp"
        android:layout_marginTop="10dp"
        android:id="@+id/login2img"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:src="@drawable/password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="20dp"
            android:background="@drawable/shape_login_edt"
            android:hint="Login"
            android:paddingLeft="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="20dp"
            android:background="@drawable/shape_login_edt"
            android:hint="Parol"
            android:paddingLeft="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="20dp"
            android:background="@drawable/shape_login_edt"
            android:hint="Takroriy parol"
            android:paddingLeft="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </LinearLayout>

<androidx.appcompat.widget.AppCompatButton
    android:id="@+id/royxatdanotishbtn"
  android:layout_marginRight="20dp"
    android:layout_marginLeft="20dp"
    android:background="@drawable/shape_btn"
    app:layout_constraintBottom_toBottomOf="parent"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="80dp"
    android:text="Ro'yxatdan o'tish"
    android:textStyle="bold"
    android:textSize="20dp"
    android:textColor="#282A27"/>

    <TextView
        android:id="@+id/otgantxt"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="40dp"
        android:textSize="20dp"
        android:layout_marginStart="70dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="siz oldin ro'yxatdan o'tganmisiz"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/royxatdanotishbtn"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
         />

</androidx.constraintlayout.widget.ConstraintLayout>